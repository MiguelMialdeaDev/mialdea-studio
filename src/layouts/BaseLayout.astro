---
import '../styles/global.css';
import { site, seo } from '../data/config';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Preguntas y respuestas para el schema FAQPage. Solo donde de verdad se pintan. */
  faqSchema?: { q: string; a: string }[];
}
const {
  title = seo.home.title,
  description = seo.home.description,
  noindex = false,
  faqSchema,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const ruta = Astro.url.pathname.replace(base, '/').replace(/\/{2,}/g, '/');
const canonical = new URL(ruta, site.url).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    {faqSchema && faqSchema.length > 0 && (
      <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqSchema.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      })} />
    )}

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'ProfessionalService',
      name: site.name,
      description: description,
      areaServed: 'Provincia de Valencia',
      telephone: '+34617983637',
      url: site.url,
      founder: { '@type': 'Person', name: site.founder },
      knowsAbout: ['Webs para negocios locales', 'Ficha de Google', 'Que te encuentren en Google'],
    })} />

    {/*
      MEDICION. Dos piezas, las dos sin cookies y sin terceros, asi que no hace
      falta banner de consentimiento:

      1. Visitas y origen: Cloudflare Web Analytics. NO se instala aqui. Se activa
         en el panel de Cloudflare, en el proyecto de Pages, apartado Analytics,
         y Cloudflare inyecta su script solo. Si algun dia se desactiva ahi, esta
         web deja de medir visitas y no hay nada que tocar en el codigo.

      2. Clics en llamar y en WhatsApp: el script del final del body. Manda un
         aviso a /e/llamada o /e/whatsapp, que no existen como pagina y devuelven
         404 a proposito. Lo que interesa no es la respuesta, es que Cloudflare
         cuenta la peticion por ruta en las analiticas del proyecto. Asi se puede
         decir cuantos clics de llamada salieron de la web sin instalar nada de
         terceros ni pedirle datos a nadie.
    */}
  </head>
  <body class="font-sans antialiased">
    <slot />

    <script is:inline>
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
      );
      document.querySelectorAll('.reveal').forEach((el, i) => {
        el.style.transitionDelay = (i % 5) * 70 + 'ms';
        io.observe(el);
      });

      const nav = document.getElementById('nav');
      if (nav) {
        const onScroll = () => {
          if (window.scrollY > 24) nav.classList.add('scrolled');
          else nav.classList.remove('scrolled');
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      }

      // Cuenta clics en llamar y en WhatsApp.
      // Avisa a una ruta que no existe: da 404 y da igual, porque lo que cuenta
      // es que Cloudflare registra la peticion por ruta. Sin cookies, sin
      // terceros y sin guardar nada de quien hace clic.
      (function () {
        const marca = (evento) => {
          const url = '/e/' + evento;
          if (navigator.sendBeacon) navigator.sendBeacon(url);
          else fetch(url, { method: 'POST', keepalive: true }).catch(() => {});
        };
        document.addEventListener(
          'click',
          (ev) => {
            const a = ev.target.closest && ev.target.closest('a[href]');
            if (!a) return;
            const href = a.getAttribute('href') || '';
            if (href.startsWith('tel:')) marca('llamada');
            else if (href.indexOf('wa.me') !== -1) marca('whatsapp');
          },
          { capture: true, passive: true }
        );
        // El formulario ya lleva a /gracias, que se cuenta sola como visita.
      })();
    </script>
  </body>
</html>
