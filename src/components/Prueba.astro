---
// PRUEBA: dos webs abiertas. Sin cifras que no pueda respaldar.
import { home } from '../data/config';
---

<section class="border-t-[3px] border-tinta" aria-labelledby="prueba-h">
  <div class="max-w-content mx-auto px-[22px] sm:px-8 py-14 sm:py-16 grid gap-6">
    <h2 id="prueba-h" class="font-display font-bold text-tinta leading-[1.02] max-w-[20ch]" style="font-size: clamp(2rem, 1.3rem + 3vw, 3.25rem);">
      {home.prueba.titulo}
    </h2>
    <p class="text-tinta2 max-w-[58ch]">{home.prueba.intro}</p>
    <div class="grid lg:grid-cols-2 lg:gap-x-16">
      {home.prueba.sitios.map((s) => (
        <a href={s.url} target="_blank" rel="noopener" class="group grid gap-1 py-4 border-t border-linea no-underline">
          <b class="font-display font-bold text-xl text-tinta group-hover:text-terracota transition-colors">
            {s.label}<span class="text-terracota" aria-hidden="true"> ↗</span>
          </b>
          <span class="text-sm text-muted">{s.texto}</span>
        </a>
      ))}
    </div>
  </div>
</section>
