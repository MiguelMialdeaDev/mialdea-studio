---
import { faq } from '../data/config';

interface Props {
  titulo?: string;
  items?: { q: string; a: string }[];
}
const { titulo = 'Lo que sueles preguntarte', items = faq } = Astro.props;
---

<section id="faq" class="py-20 sm:py-28 bg-papel border-y border-linea">
  <div class="max-w-content mx-auto px-5 sm:px-8">
    <div class="reveal max-w-2xl mb-8">
      <h2
        class="font-display font-medium tracking-tight text-tinta"
        style="font-size: clamp(1.6rem, 3.5vw, 2.5rem); line-height: 1.1;"
      >
        {titulo}
      </h2>
    </div>

    <div class="grid gap-px bg-linea rounded-2xl overflow-hidden border border-linea">
      {items.map((f) => (
        <details class="group bg-crema">
          <summary
            class="cursor-pointer list-none flex items-center justify-between gap-4 px-6 py-5 text-tinta font-medium hover:text-terracota transition"
          >
            {f.q}
            <span class="text-muted group-open:rotate-45 transition-transform text-xl" aria-hidden="true">+</span>
          </summary>
          <div class="faq-content">
            <p class="px-6 pb-5 text-tinta/75 leading-relaxed">{f.a}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-content {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.3s ease;
  }
  details[open] .faq-content { grid-template-rows: 1fr; }
  .faq-content > p { overflow: hidden; }
  @media (prefers-reduced-motion: reduce) { .faq-content { transition: none; } }
</style>
