---
import { servicios, paquetes } from '../data/config';
---

<section id="servicios" class="py-24 sm:py-32 bg-papel border-y border-linea">
  <div class="max-w-content mx-auto px-5 sm:px-8">
    <div class="reveal max-w-2xl mb-14">
      <p class="text-xs uppercase tracking-[0.18em] text-terracota font-medium mb-4">Servicios</p>
      <h2
        class="font-display font-medium tracking-tight text-tinta"
        style="font-size: clamp(1.9rem, 4.5vw, 3.25rem); line-height: 1.05;"
      >
        Lo técnico lo llevo yo.
      </h2>
    </div>

    <div class="grid sm:grid-cols-2 gap-6 mb-20">
      {servicios.map((s) => (
        <div class="card-warm p-8 sm:p-10 flex flex-col">
          <div class="flex items-baseline justify-between gap-4 mb-3">
            <h3 class="font-display text-2xl text-tinta">{s.titulo}</h3>
            <span class="text-sm text-terracota font-medium whitespace-nowrap">{s.desde}</span>
          </div>
          <p class="text-tinta/75 leading-relaxed mb-6">{s.desc}</p>
          <ul class="space-y-2.5 mt-auto">
            {s.bullets.map((b) => (
              <li class="flex items-center gap-3 text-sm text-tinta/80">
                <span class="w-1.5 h-1.5 rounded-full bg-terracota"></span>
                {b}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="reveal mb-8">
      <h3 class="font-display text-2xl text-tinta">Cómo empezar</h3>
      <p class="text-tinta/70 mt-1">Presupuesto cerrado antes de empezar. Sabes lo que pagas y cuándo lo tienes.</p>
    </div>

    <div class="grid sm:grid-cols-3 gap-5">
      {paquetes.map((p) => (
        <div class={`rounded-2xl p-7 flex flex-col border ${p.destacado ? 'bg-tinta text-papel border-tinta' : 'bg-crema border-linea text-tinta'}`}>
          {p.destacado && (
            <span class="self-start text-[0.7rem] uppercase tracking-wider text-tinta bg-ocre rounded-full px-2.5 py-0.5 mb-4">
              Recomendado
            </span>
          )}
          <h4 class="font-medium text-lg">{p.nombre}</h4>
          <p class="font-display text-3xl mt-2">{p.precio}</p>
          <p class={`text-sm mt-1 mb-5 ${p.destacado ? 'text-papel/70' : 'text-muted'}`}>{p.desc}</p>
          <ul class="space-y-2">
            {p.incluye.map((i) => (
              <li class="flex items-start gap-2.5 text-sm">
                <span class="text-terracota mt-0.5" aria-hidden="true">&#10003;</span>
                {i}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
