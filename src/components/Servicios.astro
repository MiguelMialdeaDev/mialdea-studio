---
import { servicios, paquetes, mantenimiento } from '../data/config';
---

<section id="servicios" class="py-24 sm:py-32 border-t border-line">
  <div class="max-w-content mx-auto px-5 sm:px-8">
    <div class="reveal max-w-2xl mb-14">
      <p class="text-xs uppercase tracking-[0.18em] text-muted mb-4">Servicios</p>
      <h2
        class="font-sans font-medium tracking-tight text-paper"
        style="font-size: clamp(1.75rem, 4vw, 3rem); line-height: 1.05;"
      >
        Todo lo tecnico, resuelto.
      </h2>
    </div>

    <div class="grid sm:grid-cols-2 gap-6 mb-20">
      {servicios.map((s) => (
        <div class="reveal gcard transition-transform duration-300 hover:-translate-y-1">
          <div class="gcard-inner p-8 sm:p-10 h-full flex flex-col">
            <div class="flex items-baseline justify-between gap-4 mb-3">
              <h3 class="font-display text-3xl text-paper">{s.titulo}</h3>
              <span class="text-sm text-accent font-medium whitespace-nowrap">{s.desde}</span>
            </div>
            <p class="text-paper/80 leading-relaxed mb-6">{s.desc}</p>
            <ul class="space-y-2.5 mt-auto">
              {s.bullets.map((b) => (
                <li class="flex items-center gap-3 text-sm text-paper/85">
                  <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
                  {b}
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>

    <!-- Paquetes -->
    <div class="reveal mb-8">
      <h3 class="text-paper font-medium text-xl">Elige como empezar</h3>
      <p class="text-muted mt-1">Presupuesto cerrado antes de empezar. Sabes lo que pagas y cuando lo tienes.</p>
    </div>

    <div class="grid sm:grid-cols-3 gap-5">
      {paquetes.map((p) => (
        <div class={`reveal rounded-2xl p-7 flex flex-col border transition-transform duration-300 hover:-translate-y-1 ${p.destacado ? 'bg-surface border-accent/50 shadow-[0_0_0_1px_rgba(200,255,60,0.25)]' : 'bg-surface border-line'}`}>
          {p.destacado && (
            <span class="self-start text-[0.7rem] uppercase tracking-wider text-ink bg-accent rounded-full px-2.5 py-0.5 mb-4">
              Recomendado
            </span>
          )}
          <h4 class="text-paper font-medium text-lg">{p.nombre}</h4>
          <p class="font-display text-3xl text-paper mt-2">{p.precio}</p>
          <p class="text-sm text-muted mt-1 mb-5">{p.desc}</p>
          <ul class="space-y-2 mb-2">
            {p.incluye.map((i) => (
              <li class="flex items-start gap-2.5 text-sm text-paper/85">
                <span class="text-accent mt-0.5" aria-hidden="true">&#10003;</span>
                {i}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Mantenimiento -->
    <div class="reveal mt-10 grid sm:grid-cols-2 gap-5">
      {mantenimiento.map((m) => (
        <div class="flex items-start gap-4 bg-ink border border-line rounded-xl p-5">
          <span class="w-2 h-2 rounded-full bg-accent mt-2 shrink-0"></span>
          <div>
            <div class="flex items-baseline gap-2 flex-wrap">
              <span class="text-paper font-medium">{m.nombre}</span>
              <span class="text-accent text-sm">{m.precio}</span>
            </div>
            <p class="text-sm text-muted mt-1 leading-relaxed">{m.incluye}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
