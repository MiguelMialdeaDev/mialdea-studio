---
// CIERRE: la revisión gratis. Un botón, verde, WhatsApp.
import { home, waLink } from '../data/config';
const wa = waLink('Hola Miguel, quiero la revisión gratis de mi web.');
---

<section id="revision" class="border-t-[3px] border-tinta" aria-labelledby="rev-h">
  <div class="max-w-content mx-auto px-[22px] sm:px-8 py-14 sm:py-16 grid gap-6">
    <h2 id="rev-h" class="font-display font-bold text-tinta leading-[1.02] max-w-[20ch]" style="font-size: clamp(2rem, 1.3rem + 3vw, 3.25rem);">
      {home.revision.titulo}
    </h2>
    <p class="text-tinta2 max-w-[58ch]">{home.revision.texto}</p>
    <a
      href={wa}
      target="_blank"
      rel="noopener"
      class="inline-flex items-center gap-2.5 min-h-[52px] px-6 py-3.5 rounded-full bg-wa text-papel text-base font-semibold hover:bg-waDark transition-colors whitespace-nowrap w-fit"
    >
      <svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.5 14.4c-.3-.1-1.8-.9-2-1-.3-.1-.5-.1-.7.1l-.9 1.2c-.2.2-.3.2-.6.1-.3-.1-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.5-.5.3-.5c.1-.2 0-.4 0-.5l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5 2.5 1 3 .8 3.6.8.5-.1 1.8-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.2-.3-.3-.6-.4zM12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2z"/></svg>
      {home.revision.cta}
    </a>
  </div>
</section>
