---
import { site, quienSoy, link } from '../data/config';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const foto = `${base}${site.foto}`;
---

<section id="sobre-mi" class="py-20 sm:py-28 bg-papel border-y border-linea">
  <div class="max-w-content mx-auto px-5 sm:px-8 grid md:grid-cols-[300px_1fr] gap-10 md:gap-14 items-center">
    <div class="reveal">
      <div class="rounded-2xl overflow-hidden border border-linea bg-crema">
        <img
          src={foto}
          alt={`Miguel Mialdea, que es quien hace la web y quien te coge el teléfono`}
          width="300"
          height="360"
          class="w-full h-[360px] object-cover"
          onerror="this.style.display='none'; this.parentElement.classList.add('foto-ph');"
        />
      </div>
    </div>

    <div class="reveal">
      <p class="text-xs uppercase tracking-[0.18em] text-terracota font-medium mb-5">Quién soy</p>
      <h2
        class="font-display font-medium tracking-tight text-tinta mb-5"
        style="font-size: clamp(1.7rem, 3.5vw, 2.5rem); line-height: 1.1;"
      >
        Soy {site.founder}. Tu web la hago yo, de principio a fin.
      </h2>
      <p class="text-lg text-tinta/80 leading-relaxed mb-4 max-w-2xl">
        {quienSoy.resumenPortada}
      </p>
      <p class="text-tinta/75 leading-relaxed max-w-2xl">
        No soy una agencia con comerciales. Hablas conmigo antes y después, te lo
        explico todo en cristiano y de lo técnico me encargo yo. Tú a lo tuyo.
      </p>
      <a
        href={link('/quien-soy')}
        class="inline-flex items-center gap-2 mt-6 text-base font-medium text-tinta underline underline-offset-4 hover:text-terracota transition"
      >
        Quién soy y por qué acabé haciendo esto
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </div>
</section>

<style>
  .foto-ph {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 360px;
  }
  .foto-ph::after {
    content: 'Foto de Miguel pendiente';
    color: #8c8378;
    font-size: 0.85rem;
  }
</style>
