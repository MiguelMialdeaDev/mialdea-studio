---
import { site, quienSoy, link } from '../data/config';
import { existsSync } from 'node:fs';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const foto = `${base}${site.foto}`;
// Solo se pinta la etiqueta si el fichero existe: antes cada visita pedia un jpg que daba 404.
const hayFoto = existsSync('public' + site.foto);
---

<section id="sobre-mi" class="py-20 sm:py-28 bg-papel border-y border-linea">
  <div class="max-w-content mx-auto px-[22px] sm:px-8 grid md:grid-cols-[300px_1fr] gap-10 md:gap-14 items-center">
    <div class="reveal">
      <div class="rounded-lg overflow-hidden border border-linea bg-crema">
        {hayFoto ? (
          <img src={foto}
          alt={`Miguel Mialdea, que es quien hace la web y quien te coge el teléfono`}
          width="300"
          height="360"
          class="w-full h-[360px] object-cover" />
          ) : (
          null
          )}
      </div>
    </div>

    <div class="reveal">
      <p class="text-sm uppercase tracking-[0.04em] text-terracota font-semibold mb-5">Quién soy</p>
      <h2
        class="font-display font-bold tracking-tight text-tinta mb-5"
        style="font-size: clamp(1.7rem, 3.5vw, 2.5rem); line-height: 1.1;"
      >
        Soy {site.founder}. Tu web la hago yo, de principio a fin.
      </h2>
      <p class="text-lg text-tinta2 leading-relaxed mb-4 max-w-2xl">
        {quienSoy.resumenPortada}
      </p>
      <p class="text-tinta2 leading-relaxed max-w-2xl">
        No soy una agencia con comerciales. Hablas conmigo antes y después, te lo
        explico todo en cristiano y de lo técnico me encargo yo. Tú a lo tuyo.
      </p>
      <a
        href={link('/quien-soy')}
        class="inline-flex items-center gap-2 mt-6 text-base font-medium text-tinta underline underline-offset-4 hover:text-terracota transition"
      >
        Quién soy y por qué acabé haciendo esto
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </div>
</section>

<style>
  .foto-ph {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 360px;
  }
  .foto-ph::after {
    content: 'Foto de Miguel pendiente';
    color: oklch(42% 0.012 45);
    font-size: 0.85rem;
  }
</style>
