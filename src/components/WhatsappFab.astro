---
// BARRA FIJA DE MÓVIL. Abajo, donde llega el pulgar, en todas las páginas.
// En escritorio no hace falta: el botón de WhatsApp está en la cabecera.
import { waLink } from '../data/config';
const wa = waLink();
---

<aside
  class="lg:hidden fixed inset-x-0 bottom-0 z-40 flex items-center justify-between gap-3 px-[22px] py-3 bg-crema border-t border-linea"
  aria-label="Contacto rápido"
>
  <span class="text-[0.8125rem] text-muted">Te contesto yo, el mismo día.</span>
  <a
    href={wa}
    target="_blank"
    rel="noopener"
    class="inline-flex items-center gap-2 min-h-[44px] px-4 py-2 rounded-full bg-wa text-papel text-sm font-semibold hover:bg-waDark transition-colors whitespace-nowrap"
  >
    <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.5 14.4c-.3-.1-1.8-.9-2-1-.3-.1-.5-.1-.7.1l-.9 1.2c-.2.2-.3.2-.6.1-.3-.1-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.5-.5.3-.5c.1-.2 0-.4 0-.5l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5 2.5 1 3 .8 3.6.8.5-.1 1.8-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.2-.3-.3-.6-.4zM12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2z"/></svg>
    WhatsApp
  </a>
</aside>

<style>
  /* Deja sitio a la barra para que no tape el pie. */
  :global(body) { padding-bottom: 4.5rem; }
  @media (min-width: 1024px) { :global(body) { padding-bottom: 0; } }
</style>
