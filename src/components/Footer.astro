---
// PIE. Una frase grande (la promesa de la casa) y debajo lo mínimo: teléfono,
// y los enlaces que Google necesita para llegar a gremios y zonas.
import { site, nav, link, gremios, zonas } from '../data/config';
const year = 2026;
---

<footer class="border-t-[3px] border-tinta">
  <div class="max-w-content mx-auto px-[22px] sm:px-8 pt-16 pb-8 sm:pt-24 grid gap-8">
    <p class="font-display font-bold text-tinta leading-none max-w-[22ch]" style="font-size: clamp(1.75rem, 1rem + 3.4vw, 3.25rem);">
      {site.tagline}
    </p>

    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4 pt-6 border-t border-linea text-sm">
      <div class="grid gap-2 content-start">
        <span class="font-wordmark font-semibold text-lg text-tinta leading-none">Mialdea <span class="text-terracota">studio</span></span>
        <a href={site.telefonoLink} class="text-tinta font-semibold no-underline hover:text-terracota transition-colors w-fit">
          {site.telefono}
        </a>
      </div>
      <nav class="grid gap-1.5 content-start" aria-label="Webs por gremio y zona">
        <span class="font-semibold text-tinta">Por gremio</span>
        {gremios.map((g) => (
          <a href={link(`/${g.slug}`)} class="text-muted hover:text-tinta transition-colors no-underline w-fit">{g.menuLabel}</a>
        ))}
      </nav>
      <nav class="grid gap-1.5 content-start" aria-label="Diseño web por zona">
        <span class="font-semibold text-tinta">Diseño web por zona</span>
        {zonas.map((z) => (
          <a href={link(`/${z.slug}`)} class="text-muted hover:text-tinta transition-colors no-underline w-fit">{z.municipio}</a>
        ))}
      </nav>
      <nav class="grid gap-1.5 content-start" aria-label="Enlaces del pie">
        <span class="font-semibold text-tinta">El estudio</span>
        {nav.map((item) => (
          <a href={link(item.href)} class="text-muted hover:text-tinta transition-colors no-underline w-fit">{item.label}</a>
        ))}
      </nav>
    </div>

    <p class="text-sm text-muted pt-4 border-t border-linea">&copy; {year} Mialdea Studio · {site.location}</p>
  </div>
</footer>
