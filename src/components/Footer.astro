---
import { site, nav, link } from '../data/config';
const year = 2026;
---

<footer class="border-t border-linea py-12 bg-papel">
  <div class="max-w-content mx-auto px-5 sm:px-8 flex flex-col sm:flex-row gap-8 sm:items-start sm:justify-between">
    <div>
      <div class="flex items-baseline gap-1.5 mb-2">
        <span class="font-display text-xl text-tinta">Mialdea</span>
        <span class="text-xs text-muted lowercase">studio</span>
        <span class="w-1.5 h-1.5 rounded-full bg-terracota self-end mb-1"></span>
      </div>
      <p class="text-sm text-tinta/75 max-w-xs">{site.tagline}</p>
      <p class="text-sm text-muted max-w-xs mt-2">
        Webs para negocios de la provincia de {site.location}.
      </p>
      <a
        href={site.telefonoLink}
        class="inline-flex items-center gap-2 mt-4 text-base font-medium text-tinta hover:text-terracota transition"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.4.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1l-2.3 2.2z"></path>
        </svg>
        Llamar al {site.telefono}
      </a>
    </div>

    <nav class="flex flex-col gap-2" aria-label="Enlaces del pie">
      {nav.map((item) => (
        <a href={link(item.href)} class="text-sm text-muted hover:text-tinta transition">{item.label}</a>
      ))}
    </nav>
  </div>

  <div class="max-w-content mx-auto px-5 sm:px-8 mt-10 pt-6 border-t border-linea flex flex-col sm:flex-row gap-2 sm:justify-between text-xs text-muted">
    <span>&copy; {year} Mialdea Studio.</span>
    <span>Hecho con cariño desde {site.location}.</span>
  </div>
</footer>
