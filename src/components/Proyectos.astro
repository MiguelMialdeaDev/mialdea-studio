---
import { proyectos, site } from '../data/config';
const waBase = site.whatsapp ? `https://wa.me/${site.whatsapp}` : '#contacto';
---

<section id="proyectos" class="py-24 sm:py-32">
  <div class="max-w-content mx-auto px-5 sm:px-8">
    <div class="reveal max-w-2xl mb-14">
      <p class="text-xs uppercase tracking-[0.18em] text-muted mb-4">Proyectos</p>
      <h2
        class="font-sans font-medium tracking-tight text-paper"
        style="font-size: clamp(1.75rem, 4vw, 3rem); line-height: 1.05;"
      >
        Lo que hago con un negocio,
        <span class="text-muted">lo hago con el tuyo.</span>
      </h2>
    </div>

    <div class="grid gap-6">
      {proyectos.map((p) => {
        const wa = site.whatsapp
          ? `${waBase}?text=${encodeURIComponent(`Hola Miguel, vi el proyecto de ${p.nombre} y quiero algo asi para mi negocio.`)}`
          : '#contacto';
        return (
          <article class="reveal gcard">
            <div class="gcard-inner spotlight p-7 sm:p-10">
              <div class="flex items-center gap-3 mb-5">
                <span class="font-display text-3xl sm:text-4xl text-paper">{p.nombre}</span>
                {p.destacado && (
                  <span class="text-[0.7rem] uppercase tracking-wider text-accent border border-accent/40 rounded-full px-2.5 py-0.5">
                    Caso destacado
                  </span>
                )}
              </div>
              <p class="text-sm text-muted mb-1">{p.tipo}</p>
              <p class="text-paper/85 leading-relaxed max-w-2xl">{p.descripcion}</p>

              {p.resultado && (
                <div class="mt-6 inline-flex items-center gap-3 bg-ink border border-line rounded-xl px-4 py-3">
                  <span class="text-accent text-lg" aria-hidden="true">&uarr;</span>
                  <span class="text-paper font-medium text-sm">{p.resultado}</span>
                </div>
              )}

              {p.testimonio && (
                <blockquote class="mt-6 border-l-2 border-accent/50 pl-4 text-paper/80 italic">
                  "{p.testimonio}"
                  {p.testimonio_autor && (
                    <cite class="block not-italic text-sm text-muted mt-1">{p.testimonio_autor}</cite>
                  )}
                </blockquote>
              )}

              <div class="flex flex-wrap gap-2 mt-6">
                {p.stack.map((t) => (
                  <span class="text-xs text-muted bg-ink border border-line rounded-full px-3 py-1">
                    {t}
                  </span>
                ))}
              </div>

              <div class="flex flex-wrap items-center gap-4 mt-8">
                <a
                  href={wa}
                  class="inline-flex items-center gap-2 text-sm font-medium text-ink bg-accent px-5 py-2.5 rounded-full hover:brightness-110 transition"
                >
                  Quiero algo asi
                  <span aria-hidden="true">&rarr;</span>
                </a>
                {p.url && (
                  <a
                    href={p.url}
                    target="_blank"
                    rel="noopener"
                    class="text-sm text-paper/80 hover:text-paper underline underline-offset-4"
                  >
                    Ver web en vivo
                  </a>
                )}
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>
