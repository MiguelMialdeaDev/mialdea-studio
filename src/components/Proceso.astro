---
import { comoTrabajo, link } from '../data/config';

interface Props {
  titulo?: string;
  kicker?: string;
  enlace?: boolean;
}
const {
  titulo = 'Cinco pasos, y ninguna sorpresa a mitad',
  kicker = 'Cómo trabajo',
  enlace = false,
} = Astro.props;
---

<section id="proceso" class="py-20 sm:py-28">
  <div class="max-w-content mx-auto px-5 sm:px-8">
    <div class="reveal max-w-2xl mb-12">
      <p class="text-xs uppercase tracking-[0.18em] text-terracota font-medium mb-4">{kicker}</p>
      <h2
        class="font-display font-medium tracking-tight text-tinta"
        style="font-size: clamp(1.75rem, 4vw, 2.75rem); line-height: 1.05;"
      >
        {titulo}
      </h2>
    </div>

    <ol class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {comoTrabajo.pasos.map((p) => (
        <li class="reveal">
          <span class="font-display text-4xl text-terracota">{p.n}</span>
          <h3 class="font-display text-xl text-tinta mt-3 mb-2">{p.titulo}</h3>
          <p class="text-tinta/75 leading-relaxed">{p.desc}</p>
        </li>
      ))}
    </ol>

    {enlace && (
      <div class="reveal mt-12">
        <a
          href={link('/como-trabajo')}
          class="inline-flex items-center gap-2 text-base font-medium text-tinta underline underline-offset-4 hover:text-terracota transition"
        >
          Ver cómo trabajo al detalle, con precios y plazos
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    )}
  </div>
</section>
