---
// PÁGINA DE ZONA  ·  el eje "diseño web + municipio"
//
// Forge · sistema heredado del sitio (Fraunces + Inter, crema/terracota,
// card-warm, reveal). Diversificación INVERTIDA a propósito: en un sitio con
// sistema propio las páginas nuevas comparten la espina, no se diferencian.
// Pre-emit: P5 H5 E4 S5 R5 V4.
//
// POR QUÉ ESTE EJE Y NO "gremio + municipio":
// Search Console (3 meses, 96 impresiones, 0 clics) dice que las páginas de
// gremio ya posicionan para el cliente DEL cliente ("electricista godella",
// "fontanero en corbera": 6 de 8 consultas). Esa gente quiere un electricista
// y no hace clic nunca. La única consulta del cliente real que aparece es
// "diseño web l'alcudia". Así que el municipio va en este eje.
//
// Y para que no sean páginas puerta, cada zona trae su propio bloque
// `angulo` con algo verdadero y distinto: dónde vive, dónde ya tiene
// cliente, y la ciudad.
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from './Nav.astro';
import Faq from './Faq.astro';
import Footer from './Footer.astro';
import WhatsappFab from './WhatsappFab.astro';
import {
  site,
  link,
  waLink,
  gremioComun,
  gremios,
  zonas,
  pruebaMariano,
  faq,
  type Zona,
} from '../data/config';

interface Props {
  zona: Zona;
}
const { zona: z } = Astro.props;
const wa = waLink(z.waMensaje);
const c = gremioComun;
const otrasZonas = zonas.filter((o) => o.slug !== z.slug);
const prueba = pruebaMariano;
---

<BaseLayout title={z.seo.title} description={z.seo.description} faqSchema={faq.slice(0, 5)}>
  <Nav />
  <main>
    <!-- Hero con el precio a la vista. Una sola acción: WhatsApp. -->
    <section class="pt-28 pb-14 sm:pt-40 sm:pb-20 relative overflow-hidden">

      <div
        class="max-w-content mx-auto px-[22px] sm:px-8 relative grid lg:grid-cols-[1fr,340px] gap-10 lg:gap-16 items-start"
      >
        <div>
          <p class="text-sm uppercase tracking-[0.04em] text-terracota font-semibold mb-4">{z.kicker}</p>
          <h1
            class="font-display font-bold text-tinta leading-[1.05] tracking-tight max-w-3xl"
            style="font-size: clamp(2.25rem, 5.5vw, 4rem); overflow-wrap: anywhere;"
          >
            {z.h1}
          </h1>
          <p class="mt-6 max-w-2xl text-xl text-tinta2 leading-relaxed">{z.sub}</p>
          <div class="mt-8 flex flex-col sm:flex-row flex-wrap gap-4">
            <a
              href={wa}
              class="inline-flex items-center justify-center gap-2 text-base font-semibold text-papel bg-wa px-6 py-3.5 rounded-full hover:bg-waDark transition-colors whitespace-nowrap"
            >
              Escríbeme por WhatsApp
            </a>
            <a
              href={site.telefonoLink}
              class="inline-flex items-center justify-center gap-2 text-base font-medium text-tinta border border-tinta px-6 py-3.5 rounded-full transition-colors whitespace-nowrap"
            >
              Llamar al {site.telefono}
            </a>
          </div>
        </div>

        <aside class="card-warm p-7 lg:mt-2">
          <p class="text-sm uppercase tracking-[0.04em] text-terracota font-semibold">{c.precio.kicker}</p>
          <p class="font-display text-4xl text-tinta mt-3">{c.precio.principal}</p>
          <p class="text-sm text-muted mt-1">{c.precio.principalNota}</p>
          <p class="text-base text-tinta2 leading-relaxed mt-4">{c.precio.resto}</p>
          <p class="text-sm text-muted mt-4 pt-4 border-t border-linea">{c.precio.letraPequena}</p>
        </aside>
      </div>
    </section>

    <!-- El ángulo propio de la zona. Es lo que evita la página puerta. -->
    <section class="py-16 sm:py-24 bg-papel border-y border-linea">
      <div class="max-w-content mx-auto px-[22px] sm:px-8">
        <div class="reveal max-w-2xl">
          <h2
            class="font-display font-bold tracking-tight text-tinta"
            style="font-size: clamp(1.75rem, 4vw, 2.75rem); line-height: 1.1; overflow-wrap: anywhere;"
          >
            {z.angulo.titulo}
          </h2>
          <p class="mt-5 text-lg text-tinta2 leading-relaxed">{z.angulo.texto}</p>
        </div>
      </div>
    </section>

    <!-- La prueba de Mariano. Solo si publicado === true, o sea solo
         cuando el cliente haya dado permiso. Sin euros a propósito. -->
    {prueba.publicado && (
      <section class="py-16 sm:py-24">
        <div class="max-w-content mx-auto px-[22px] sm:px-8">
          <div class="reveal card-warm p-8 sm:p-10">
            <p class="text-sm uppercase tracking-[0.04em] text-terracota font-semibold mb-3">
              {prueba.kicker}
            </p>
            <h2
              class="font-display font-bold tracking-tight text-tinta max-w-2xl"
              style="font-size: clamp(1.6rem, 3.6vw, 2.4rem); line-height: 1.12; overflow-wrap: anywhere;"
            >
              {prueba.titulo}
            </h2>
            <p class="mt-5 max-w-2xl text-lg text-tinta2 leading-relaxed">{prueba.texto}</p>

            <dl class="mt-8 grid grid-cols-1 sm:grid-cols-3 gap-6 sm:gap-8">
              {prueba.cifras.map((cf) => (
                <div class="border-t border-linea pt-4">
                  <dt class="font-display text-4xl sm:text-5xl text-tinta leading-none">{cf.dato}</dt>
                  <dd class="mt-2 text-sm text-muted leading-snug">{cf.etiqueta}</dd>
                </div>
              ))}
            </dl>

            <p class="mt-8 max-w-2xl text-lg text-tinta leading-relaxed">{prueba.remate}</p>
            <a
              href={prueba.url}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2 mt-5 text-base font-medium text-tinta underline underline-offset-4 hover:text-terracota transition"
            >
              {prueba.urlLabel}
              <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>
      </section>
    )}

    <!-- Qué incluye. Se reutiliza la tabla del gremio de reformas, que es
         la genérica: lo que entra es lo mismo en cualquier municipio. -->
    <section class="py-16 sm:py-24 bg-papel border-y border-linea">
      <div class="max-w-content mx-auto px-[22px] sm:px-8">
        <h2
          class="reveal font-display font-bold tracking-tight text-tinta mb-8"
          style="font-size: clamp(1.75rem, 4vw, 2.75rem); line-height: 1.1;"
        >
          Un precio, todo dentro
        </h2>
        <dl class="reveal max-w-3xl">
          {gremios[0].incluye.filas.map((f) => (
            <div class="grid sm:grid-cols-[230px,1fr] gap-1 sm:gap-6 py-3.5 border-b border-linea">
              <dt class="text-tinta font-medium">{f.th}</dt>
              <dd class="text-tinta2">{f.td}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- Quién la hace -->
    <section class="py-16 sm:py-20">
      <div class="max-w-content mx-auto px-[22px] sm:px-8">
        <div class="reveal max-w-2xl">
          <h2 class="font-display text-2xl sm:text-3xl text-tinta mb-4">{c.quien.titulo}</h2>
          <p class="text-lg text-tinta2 leading-relaxed">{c.quien.texto}</p>
          <a
            href={link('/como-trabajo')}
            class="inline-flex items-center gap-2 mt-5 text-base font-medium text-tinta underline underline-offset-4 hover:text-terracota transition"
          >
            {c.quien.enlaceTexto}
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </section>

    <Faq titulo="Lo que me sueles preguntar antes de empezar" items={faq.slice(0, 5)} />

    <!-- Pueblos de al lado, gremios y otras zonas. Enlazado interno real. -->
    <section class="py-14 sm:py-20">
      <div class="max-w-content mx-auto px-[22px] sm:px-8">
        <div class="reveal max-w-2xl">
          <h2 class="font-display text-2xl sm:text-3xl text-tinta mb-4">
            También por aquí cerca
          </h2>
          <p class="text-lg text-tinta2 leading-relaxed">
            Además de {z.municipio}, trabajo en {z.cercanos} Si estás un poco más lejos,
            pregunta, que casi todo se resuelve por teléfono.
          </p>

          <p class="mt-6 text-base text-muted">
            {c.otrosTitulo}
            {gremios.map((o, i) => (
              <>
                {' '}<a
                  href={link(`/${o.slug}`)}
                  class="text-tinta underline underline-offset-4 hover:text-terracota transition"
                >{o.enlaceEtiqueta}</a>{i < gremios.length - 1 ? (i === gremios.length - 2 ? ' y' : ',') : '.'}
              </>
            ))}
          </p>

          {otrasZonas.length > 0 && (
            <p class="mt-3 text-base text-muted">
              Y también hago webs en
              {otrasZonas.map((o, i) => (
                <>
                  {' '}<a
                    href={link(`/${o.slug}`)}
                    class="text-tinta underline underline-offset-4 hover:text-terracota transition"
                  >{o.municipio}</a>{i < otrasZonas.length - 1 ? (i === otrasZonas.length - 2 ? ' y' : ',') : '.'}
                </>
              ))}
            </p>
          )}
        </div>
      </div>
    </section>

    <!-- La única acción, repetida al cierre -->
    <section class="pb-20 sm:pb-28">
      <div class="max-w-content mx-auto px-[22px] sm:px-8">
        <div class="reveal card-warm p-8 sm:p-12 text-center">
          <h2
            class="font-display font-bold tracking-tight text-tinta"
            style="font-size: clamp(1.75rem, 4vw, 2.6rem); line-height: 1.1;"
          >
            {c.cta.titulo}
          </h2>
          <p class="mt-4 max-w-xl mx-auto text-lg text-tinta2 leading-relaxed">{c.cta.texto}</p>
          <div class="mt-7 flex flex-col sm:flex-row flex-wrap gap-4 justify-center">
            <a
              href={wa}
              class="inline-flex items-center justify-center gap-2 text-base font-semibold text-papel bg-wa px-6 py-3.5 rounded-full hover:bg-waDark transition-colors whitespace-nowrap"
            >
              Escríbeme por WhatsApp
            </a>
            <a
              href={site.telefonoLink}
              class="inline-flex items-center justify-center gap-2 text-base font-medium text-tinta border border-tinta px-6 py-3.5 rounded-full transition-colors whitespace-nowrap"
            >
              Llamar al {site.telefono}
            </a>
          </div>
          <p class="mt-5 text-sm text-muted">{c.cta.nota}</p>
          <p class="mt-6 pt-6 border-t border-linea max-w-xl mx-auto text-base text-tinta2 leading-relaxed">
            {c.cta.escalon}
          </p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <WhatsappFab />
</BaseLayout>
