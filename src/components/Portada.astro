---
// PLIEGUE DE LA PORTADA
//
// Contesta las cinco preguntas del comprador sin hacer scroll, también en un
// móvil de 320: quién eres (nombre y foto), qué haces (titular), cuánto cuesta
// (la caja de oferta), si eres de fiar (precio cerrado por escrito) y cómo
// escribirte (WhatsApp y teléfono). Un solo botón de acción, y es verde.
// La foto solo se pinta si public/miguel.jpg existe; nada de huecos "pendiente"
// a la vista del cliente. Mientras no esté, va el nombre y la frase.
import { existsSync } from 'node:fs';
import { home, site, waLink } from '../data/config';

const wa = waLink();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const hayFoto = existsSync('public' + site.foto);
const foto = `${base}${site.foto}`;
---

<section class="pt-24 pb-12 sm:pt-32 sm:pb-16 lg:pt-36 lg:pb-24">
  <div class="max-w-content mx-auto px-[22px] sm:px-8 grid gap-8 lg:grid-cols-[minmax(0,7fr)_minmax(0,4fr)] lg:gap-x-24 items-start">
    <div class="grid gap-6 min-w-0">
      <p class="text-sm uppercase tracking-[0.04em] text-terracota font-semibold">{home.kicker}</p>
      <h1
        class="font-display font-bold text-tinta leading-[1] max-w-[14ch]"
        style="font-size: clamp(2.375rem, 1.4rem + 4.4vw, 4.5rem);"
      >
        {home.h1} <span class="marca">{home.h1Marca}</span>
      </h1>
      <p class="text-xl text-tinta2 max-w-[58ch] leading-relaxed">{home.lede}</p>

      <div class="grid gap-1 px-6 py-4 border-l-[3px] border-terracota bg-crema2 max-w-[58ch] rounded-r-md">
        <p class="font-display font-extrabold text-tinta leading-[1.1]" style="font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.125rem);">
          {home.oferta.titulo}
        </p>
        <p class="text-sm text-tinta2">{home.oferta.nota}</p>
      </div>

      <div class="grid gap-3 justify-items-start">
        <a
          href={wa}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2.5 min-h-[52px] px-6 py-3.5 rounded-full bg-wa text-papel text-base font-semibold hover:bg-waDark transition-colors whitespace-nowrap"
        >
          <svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.5 14.4c-.3-.1-1.8-.9-2-1-.3-.1-.5-.1-.7.1l-.9 1.2c-.2.2-.3.2-.6.1-.3-.1-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.5-.5.3-.5c.1-.2 0-.4 0-.5l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5 2.5 1 3 .8 3.6.8.5-.1 1.8-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.2-.3-.3-.6-.4zM12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2z"/></svg>
          {home.cta}
        </a>
        <p class="text-sm text-tinta2">
          O llámame al
          <a
            href={site.telefonoLink}
            class="inline-block font-semibold text-tinta underline underline-offset-[0.2em] decoration-1 whitespace-nowrap py-3 -my-3"
          >{site.telefono}</a>. {home.alt}
        </p>
      </div>
    </div>

    <div class="flex items-center gap-4 lg:flex-col lg:items-start">
      {hayFoto ? (
        <img
          src={foto}
          alt={`${home.yo.nombre}, que es quien hace la web y quien te coge el teléfono`}
          width="320"
          height="400"
          class="w-[4.5rem] h-[4.5rem] rounded-full object-cover shrink-0 lg:w-full lg:max-w-[20rem] lg:h-auto lg:aspect-[4/5] lg:rounded-md"
        />
      ) : null}
      <p class="text-sm text-tinta2 max-w-[30ch] lg:max-w-[24ch]">
        <b class="block font-display font-bold text-base text-tinta">{home.yo.nombre}</b>
        {home.yo.texto}
      </p>
    </div>
  </div>
</section>
