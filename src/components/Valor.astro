---
const problemas = [
  'Tu competencia sale primero en Google y se lleva tus clientes.',
  'Tienes una web vieja, o ninguna, y da una imagen que no te representa.',
  'Lo tecnico te abruma y nadie te lo explica de forma clara.',
];

const valores = [
  {
    titulo: 'Mas clientes, no solo visitas',
    desc: 'La gente que entra acaba reservando, pidiendo o llamando. Para eso esta hecha.',
  },
  {
    titulo: 'Sales en Google',
    desc: 'Trabajo tu SEO local para que te encuentren cuando te buscan en tu zona.',
  },
  {
    titulo: 'Hecha por un ingeniero',
    desc: 'La construye alguien que ha desarrollado para grandes bancos. La misma exigencia, para tu negocio.',
  },
  {
    titulo: 'Hablas siempre conmigo',
    desc: 'Quien coge el telefono es quien construye tu web. Sin call centers, sin que te pasen de mano en mano.',
  },
];
---

<section class="py-24 sm:py-32 border-t border-line">
  <div class="max-w-content mx-auto px-5 sm:px-8 grid lg:grid-cols-2 gap-16">
    <div class="reveal">
      <p class="text-xs uppercase tracking-[0.18em] text-muted mb-5">
        Te suena de algo?
      </p>
      <ul class="space-y-5">
        {problemas.map((p) => (
          <li class="flex gap-4 text-lg text-paper/85 leading-relaxed">
            <span class="text-accent shrink-0 mt-1.5">&times;</span>
            {p}
          </li>
        ))}
      </ul>
    </div>

    <div class="grid gap-5">
      {valores.map((v) => (
        <div class="reveal flex gap-5 items-start border-b border-line pb-5 last:border-0">
          <span class="w-2 h-2 rounded-full bg-accent mt-2.5 shrink-0"></span>
          <div>
            <h3 class="text-paper font-medium text-lg mb-1">{v.titulo}</h3>
            <p class="text-muted leading-relaxed">{v.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
