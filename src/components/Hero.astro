---
import { portada, link, waLink } from '../data/config';
const wa = waLink('Hola Miguel, te escribo por lo de la web de mi negocio.');
---

<section id="top" class="relative pt-28 pb-16 sm:pt-40 sm:pb-24 overflow-hidden">
  <!-- mancha cálida sutil -->
  <div
    class="absolute -top-32 -right-24 w-[620px] h-[620px] rounded-full opacity-[0.18] blur-[130px] pointer-events-none"
    style="background: radial-gradient(circle, #C8553D 0%, transparent 70%);"
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute top-40 -left-32 w-[480px] h-[480px] rounded-full opacity-[0.14] blur-[120px] pointer-events-none"
    style="background: radial-gradient(circle, #E0A04D 0%, transparent 70%);"
    aria-hidden="true"
  >
  </div>

  <div class="max-w-content mx-auto px-5 sm:px-8 relative">
    <p class="text-xs uppercase tracking-[0.18em] text-terracota font-medium mb-6">
      {portada.kicker}
    </p>

    <h1
      class="font-display font-medium text-tinta leading-[1.05] tracking-tight max-w-4xl"
      style="font-size: clamp(2rem, 5vw, 4rem);"
    >
      {portada.h1}
    </h1>

    <p class="mt-7 max-w-2xl text-xl text-tinta/80 leading-relaxed">
      {portada.sub}
    </p>

    <div class="mt-9 flex flex-wrap items-center gap-4">
      <a
        href={wa}
        class="inline-flex items-center gap-2 text-base font-medium text-papel bg-terracota px-6 py-3.5 rounded-full hover:bg-terracotaDark transition"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 018.413 3.488 11.824 11.824 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 001.51 5.26l-.999 3.648 3.477-.911zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"></path>
        </svg>
        Escríbeme por WhatsApp
      </a>
      <a
        href={link('/como-trabajo')}
        class="text-base text-tinta/80 hover:text-tinta transition underline-offset-4 underline"
      >
        Antes de escribirme, mira cómo trabajo
      </a>
    </div>

    <p class="mt-8 text-sm text-muted max-w-lg">
      La hago yo, de principio a fin. Precio cerrado por escrito antes de empezar.
    </p>
  </div>
</section>
