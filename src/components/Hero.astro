---
import { site } from '../data/config';
const wa = site.whatsapp
  ? `https://wa.me/${site.whatsapp}?text=${encodeURIComponent('Hola Miguel, quiero una web para mi negocio.')}`
  : '#contacto';
---

<section id="top" class="relative pt-32 pb-20 sm:pt-40 sm:pb-28 overflow-hidden">
  <!-- mancha cálida sutil -->
  <div
    class="absolute -top-32 -right-24 w-[620px] h-[620px] rounded-full opacity-[0.18] blur-[130px] pointer-events-none"
    style="background: radial-gradient(circle, #C8553D 0%, transparent 70%);"
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute top-40 -left-32 w-[480px] h-[480px] rounded-full opacity-[0.14] blur-[120px] pointer-events-none"
    style="background: radial-gradient(circle, #E0A04D 0%, transparent 70%);"
    aria-hidden="true"
  >
  </div>

  <div class="max-w-content mx-auto px-5 sm:px-8 relative">
    <p class="reveal text-xs uppercase tracking-[0.18em] text-terracota font-medium mb-6">
      Estudio de webs y apps
    </p>

    <h1
      class="reveal font-display font-medium text-tinta leading-[1.02] tracking-tight max-w-4xl"
      style="font-size: clamp(2.5rem, 6.5vw, 5.25rem);"
    >
      Que te <span class="italic text-terracota">encuentren</span>.
      Que te elijan.
    </h1>

    <p class="reveal mt-7 max-w-xl text-lg text-tinta/75 leading-relaxed">
      Diseño webs y apps a medida para negocios que quieren hacerse notar y
      atraer clientes. Con la exigencia de quien ha desarrollado para la banca,
      y el trato de quien te coge el teléfono siempre.
    </p>

    <div class="reveal mt-9 flex flex-wrap items-center gap-4">
      <a
        href={wa}
        class="inline-flex items-center gap-2 text-base font-medium text-papel bg-terracota px-6 py-3.5 rounded-full hover:bg-terracotaDark transition"
      >
        Quiero atraer clientes
        <span aria-hidden="true">&rarr;</span>
      </a>
      <a
        href="#historias"
        class="text-base text-tinta/80 hover:text-tinta transition underline-offset-4 hover:underline"
      >
        Ver historias
      </a>
    </div>

    <p class="reveal mt-8 text-sm text-muted">
      Cada proyecto, una historia. Sin plantillas.
    </p>
  </div>
</section>
