---
// CABECERA. Logotipo a la izquierda, teléfono a la derecha, siempre visible.
// En escritorio, además, los enlaces y el botón de WhatsApp. En móvil el
// WhatsApp va en la barra fija de abajo (WhatsappFab), así que aquí no se
// repite: teléfono y menú, y nada más.
import { nav, site, link, waLink } from '../data/config';

const wa = waLink();
const actual = Astro.url.pathname.replace(/\/$/, '');
const esActual = (href: string) => actual.endsWith(href.replace(/\/$/, ''));
---

<a
  href="#inicio"
  class="sr-only focus:not-sr-only focus:absolute focus:left-[22px] focus:top-3 focus:z-[60] focus:bg-tinta focus:text-papel focus:px-3 focus:py-2 focus:rounded-md"
>
  Saltar al contenido
</a>

<header id="nav" class="fixed top-0 inset-x-0 z-50 bg-crema/95 border-b border-transparent transition-colors duration-200">
  <div class="max-w-content mx-auto px-[22px] sm:px-8">
    <div class="h-16 flex items-center justify-between gap-3">
      <a href={link('/')} class="font-wordmark font-semibold text-xl text-tinta leading-none whitespace-nowrap no-underline shrink-0">
        Mialdea<span class="text-terracota hidden min-[360px]:inline"> studio.</span>
      </a>

      <nav class="hidden lg:flex items-center gap-6" aria-label="Menú principal">
        {nav.map((item) => (
          <a
            href={link(item.href)}
            class={`text-sm py-3 transition-colors ${esActual(item.href) ? 'text-tinta font-semibold' : 'text-tinta2 hover:text-tinta'}`}
          >
            {item.label}
          </a>
        ))}
        <a
          href={site.telefonoLink}
          class="inline-flex items-center gap-2 min-h-[44px] px-4 py-2 rounded-full border border-tinta text-sm font-semibold text-tinta whitespace-nowrap"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.9.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>
          Llamar al {site.telefono}
        </a>
        <a
          href={wa}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 min-h-[44px] px-4 py-2 rounded-full bg-wa text-papel text-sm font-semibold hover:bg-waDark transition-colors whitespace-nowrap"
        >
          WhatsApp
        </a>
      </nav>

      <div class="flex lg:hidden items-center gap-2">
        <a
          href={site.telefonoLink}
          class="inline-flex items-center gap-2 min-h-[44px] px-4 py-2 rounded-full border border-tinta text-sm font-semibold text-tinta whitespace-nowrap"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.9.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>
          Llamar
        </a>
        <button
          id="menu-btn"
          type="button"
          aria-expanded="false"
          aria-controls="menu-movil"
          class="inline-flex flex-col justify-center gap-[5px] w-11 h-11 items-center rounded-full border border-tinta"
        >
          <span class="sr-only">Abrir el menú</span>
          <span class="block w-4 h-px bg-tinta" aria-hidden="true"></span>
          <span class="block w-4 h-px bg-tinta" aria-hidden="true"></span>
          <span class="block w-4 h-px bg-tinta" aria-hidden="true"></span>
        </button>
      </div>
    </div>

    <nav id="menu-movil" class="lg:hidden hidden pb-4" aria-label="Menú">
      <ul class="flex flex-col border-t border-linea pt-2">
        {nav.map((item) => (
          <li>
            <a
              href={link(item.href)}
              class={`block py-3 text-base ${esActual(item.href) ? 'text-tinta font-semibold' : 'text-tinta2'}`}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    var btn = document.getElementById('menu-btn');
    var menu = document.getElementById('menu-movil');
    if (!btn || !menu) return;
    btn.addEventListener('click', function () {
      var abierto = menu.classList.toggle('hidden') === false;
      btn.setAttribute('aria-expanded', abierto ? 'true' : 'false');
    });
  })();
</script>

<style>
  #nav.scrolled {
    border-bottom-color: theme('colors.linea');
  }
</style>
