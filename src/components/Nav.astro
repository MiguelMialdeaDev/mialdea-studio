---
import { site, nav } from '../data/config';
---

<header
  id="nav"
  class="fixed top-0 inset-x-0 z-50 transition-all duration-300 border-b border-transparent"
>
  <div class="max-w-content mx-auto px-5 sm:px-8 h-16 flex items-center justify-between">
    <a href="#top" class="flex items-baseline gap-1.5 group">
      <span class="font-display text-2xl tracking-tight text-paper">Mialdea</span>
      <span class="text-sm text-muted lowercase tracking-wide">studio</span>
      <span class="w-1.5 h-1.5 rounded-full bg-accent self-end mb-1.5"></span>
    </a>

    <nav class="hidden md:flex items-center gap-8">
      {nav.map((item) => (
        <a
          href={item.href}
          class="text-sm text-muted hover:text-paper transition-colors"
        >
          {item.label}
        </a>
      ))}
      <a
        href="#contacto"
        class="text-sm font-medium text-ink bg-accent px-4 py-2 rounded-full hover:brightness-110 transition"
      >
        Hablemos
      </a>
    </nav>

    <a
      href="#contacto"
      class="md:hidden text-sm font-medium text-ink bg-accent px-4 py-2 rounded-full"
    >
      Hablemos
    </a>
  </div>
</header>

<style>
  #nav.scrolled {
    background: rgba(10, 10, 11, 0.72);
    backdrop-filter: blur(12px);
    border-bottom-color: #26262a;
  }
</style>
