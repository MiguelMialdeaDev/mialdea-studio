---
import { nav, site, link, waLink } from '../data/config';

const wa = waLink('Hola Miguel, te escribo por lo de la web de mi negocio.');
const actual = Astro.url.pathname.replace(/\/$/, '');
const esActual = (href: string) => actual.endsWith(href.replace(/\/$/, ''));
---

<header
  id="nav"
  class="fixed top-0 inset-x-0 z-50 transition-all duration-300 border-b border-transparent bg-crema/95 md:bg-transparent"
>
  <div class="max-w-content mx-auto px-5 sm:px-8">
    <div class="h-16 flex items-center justify-between gap-3">
      <a href={link('/')} class="flex items-baseline gap-1.5 shrink-0">
        <span class="font-display text-2xl text-tinta">Mialdea</span>
        <span class="text-sm text-muted lowercase">studio</span>
        <span class="w-1.5 h-1.5 rounded-full bg-terracota self-end mb-1.5"></span>
      </a>

      <nav class="hidden md:flex items-center gap-6" aria-label="Menú principal">
        {nav.map((item) => (
          <a
            href={link(item.href)}
            class={`text-sm transition-colors ${esActual(item.href) ? 'text-tinta font-medium' : 'text-tinta/70 hover:text-tinta'}`}
          >
            {item.label}
          </a>
        ))}
        <a
          href={site.telefonoLink}
          class="inline-flex items-center gap-1.5 text-sm text-tinta/80 hover:text-tinta transition"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.4.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1l-2.3 2.2z"></path>
          </svg>
          Llamar al {site.telefono}
        </a>
        <a
          href={wa}
          class="inline-flex items-center gap-2 text-sm font-medium text-papel bg-terracota px-4 py-2 rounded-full hover:bg-terracotaDark transition"
        >
          Escríbeme por WhatsApp
        </a>
      </nav>

      <div class="flex md:hidden items-center gap-2">
        <a
          href={site.telefonoLink}
          class="inline-flex items-center gap-1.5 text-sm font-medium text-tinta border border-linea bg-papel px-3 py-2 rounded-full"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.4.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1l-2.3 2.2z"></path>
          </svg>
          Llamar
        </a>
        <a
          href={wa}
          class="inline-flex items-center gap-1.5 text-sm font-medium text-papel bg-terracota px-3.5 py-2 rounded-full"
        >
          WhatsApp
        </a>
        <button
          id="menu-btn"
          type="button"
          aria-expanded="false"
          aria-controls="menu-movil"
          class="inline-flex flex-col justify-center gap-[5px] w-9 h-9 items-center rounded-full border border-linea bg-papel"
        >
          <span class="sr-only">Abrir el menú</span>
          <span class="block w-4 h-px bg-tinta" aria-hidden="true"></span>
          <span class="block w-4 h-px bg-tinta" aria-hidden="true"></span>
          <span class="block w-4 h-px bg-tinta" aria-hidden="true"></span>
        </button>
      </div>
    </div>

    <nav id="menu-movil" class="md:hidden hidden pb-4" aria-label="Menú">
      <ul class="flex flex-col gap-1 border-t border-linea pt-3">
        {nav.map((item) => (
          <li>
            <a
              href={link(item.href)}
              class={`block py-2 text-base ${esActual(item.href) ? 'text-tinta font-medium' : 'text-tinta/80'}`}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    var btn = document.getElementById('menu-btn');
    var menu = document.getElementById('menu-movil');
    if (!btn || !menu) return;
    btn.addEventListener('click', function () {
      var abierto = menu.classList.toggle('hidden') === false;
      btn.setAttribute('aria-expanded', abierto ? 'true' : 'false');
    });
  })();
</script>

<style>
  #nav.scrolled {
    background: rgba(248, 243, 234, 0.92);
    backdrop-filter: blur(12px);
    border-bottom-color: #e7ddcd;
  }
</style>
