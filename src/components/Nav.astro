---
import { nav, site } from '../data/config';
const wa = site.whatsapp
  ? `https://wa.me/${site.whatsapp}?text=${encodeURIComponent('Hola Miguel, quiero info para mi negocio.')}`
  : '#contacto';
---

<header
  id="nav"
  class="fixed top-0 inset-x-0 z-50 transition-all duration-300 border-b border-transparent"
>
  <div class="max-w-content mx-auto px-5 sm:px-8 h-16 flex items-center justify-between">
    <a href="#top" class="flex items-baseline gap-1.5">
      <span class="font-display text-2xl text-tinta">Mialdea</span>
      <span class="text-sm text-muted lowercase">studio</span>
      <span class="w-1.5 h-1.5 rounded-full bg-terracota self-end mb-1.5"></span>
    </a>

    <nav class="hidden md:flex items-center gap-7">
      {nav.map((item) => (
        <a href={item.href} class="text-sm text-tinta/70 hover:text-tinta transition-colors">
          {item.label}
        </a>
      ))}
      <a
        href={wa}
        class="text-sm font-medium text-papel bg-terracota px-4 py-2 rounded-full hover:bg-terracotaDark transition"
      >
        Hablemos
      </a>
    </nav>

    <a
      href={wa}
      class="md:hidden text-sm font-medium text-papel bg-terracota px-4 py-2 rounded-full"
    >
      Hablemos
    </a>
  </div>
</header>

<style>
  #nav.scrolled {
    background: rgba(248, 243, 234, 0.82);
    backdrop-filter: blur(12px);
    border-bottom-color: #e7ddcd;
  }
</style>
