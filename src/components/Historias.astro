---
import { historias, link } from '../data/config';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

interface Props {
  titulo?: string;
  intro?: string;
  limite?: number;
  enlace?: boolean;
}
const {
  titulo = 'Gente de aquí que ha dado el salto',
  intro = 'Clientes de verdad, contados en corto.',
  limite = 0,
  enlace = false,
} = Astro.props;

const lista = limite > 0 ? historias.slice(0, limite) : historias;

const colores: Record<string, string> = {
  terracota: '#C8553D',
  verde: '#5B7B5A',
  ocre: '#E0A04D',
};
---

<section id="historias" class="py-20 sm:py-28">
  <div class="max-w-content mx-auto px-5 sm:px-8">
    <div class="reveal max-w-2xl mb-12">
      <p class="text-xs uppercase tracking-[0.18em] text-terracota font-medium mb-4">Trabajos</p>
      <h2
        class="font-display font-medium tracking-tight text-tinta"
        style="font-size: clamp(1.75rem, 4vw, 2.75rem); line-height: 1.05;"
      >
        {titulo}
      </h2>
      <p class="mt-5 text-lg text-tinta/75 leading-relaxed">{intro}</p>
    </div>

    <div class="grid sm:grid-cols-2 gap-6">
      {lista.map((h) => (
        <article class="card-warm overflow-hidden flex flex-col">
          {h.portada ? (
            <img
              src={`${base}/images/${h.portada}`}
              alt={h.titulo}
              loading="lazy"
              class="w-full aspect-[16/10] object-cover"
            />
          ) : (
            <div
              class="w-full aspect-[16/7] flex items-end p-6"
              style={`background: linear-gradient(135deg, ${colores[h.color]}22, ${colores[h.color]}08);`}
            >
              <span
                class="text-xs uppercase tracking-wider font-medium px-3 py-1 rounded-full"
                style={`color: ${colores[h.color]}; background: ${colores[h.color]}1A;`}
              >
                {h.etiqueta}
              </span>
            </div>
          )}

          <div class="p-7 flex flex-col flex-1">
            <p class="text-sm text-muted mb-1">{h.quien}</p>
            <h3 class="font-display text-2xl text-tinta leading-snug mb-3">{h.titulo}</h3>
            <p class="text-tinta/75 leading-relaxed">{h.resumen}</p>
          </div>
        </article>
      ))}
    </div>

    {enlace && (
      <div class="reveal mt-10">
        <a
          href={link('/trabajos')}
          class="inline-flex items-center gap-2 text-base font-medium text-tinta underline underline-offset-4 hover:text-terracota transition"
        >
          Ver un trabajo contado por dentro
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    )}
  </div>
</section>
