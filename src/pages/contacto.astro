---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Formulario from '../components/Formulario.astro';
import Revision from '../components/Revision.astro';
import Footer from '../components/Footer.astro';
import { seo, contacto, site, capacidad, link } from '../data/config';
---

<BaseLayout title={seo.contacto.title} description={seo.contacto.description}>
  <Nav />
  <main>
    <section class="pt-28 pb-12 sm:pt-40 sm:pb-16 relative overflow-hidden">
      <div
        class="absolute -top-32 -right-24 w-[560px] h-[560px] rounded-full opacity-[0.16] blur-[130px] pointer-events-none"
        style="background: radial-gradient(circle, #C8553D 0%, transparent 70%);"
        aria-hidden="true"
      >
      </div>

      <div class="max-w-content mx-auto px-5 sm:px-8 relative">
        <h1
          class="font-display font-medium text-tinta leading-[1.05] tracking-tight max-w-3xl"
          style="font-size: clamp(2.25rem, 5.5vw, 3.75rem);"
        >
          {contacto.titulo}
        </h1>
        <p class="mt-7 max-w-2xl text-xl text-tinta/80 leading-relaxed">{contacto.intro}</p>

        <a
          href={site.telefonoLink}
          class="inline-flex items-center gap-2 mt-7 text-lg font-medium text-tinta border border-linea bg-papel px-6 py-3.5 rounded-full hover:border-terracota transition"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.4.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1l-2.3 2.2z"></path>
          </svg>
          Llamar al {site.telefono}
        </a>
      </div>
    </section>

    <section class="pb-16 sm:pb-24">
      <div class="max-w-content mx-auto px-5 sm:px-8">
        <Formulario />
      </div>
    </section>

    <section class="py-14 bg-papel border-y border-linea">
      <div class="max-w-content mx-auto px-5 sm:px-8">
        <div class="max-w-2xl">
          <h2 class="font-display text-2xl text-tinta mb-4">{capacidad.titulo}</h2>
          {capacidad.parrafos.map((p) => (
            <p class="text-lg text-tinta/80 leading-relaxed mb-4">{p}</p>
          ))}
          <a
            href={link('/como-trabajo')}
            class="inline-flex items-center gap-2 text-base font-medium text-tinta underline underline-offset-4 hover:text-terracota transition"
          >
            Antes de escribirme, mira cómo trabajo
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </section>

    <Revision />
  </main>
  <Footer />
</BaseLayout>
