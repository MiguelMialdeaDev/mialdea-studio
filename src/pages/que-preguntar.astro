---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
import WhatsappFab from '../components/WhatsappFab.astro';
import { seo, quePreguntar, link } from '../data/config';
---

<BaseLayout title={seo.quePreguntar.title} description={seo.quePreguntar.description}>
  <Nav />
  <main>
    <section class="pt-28 pb-12 sm:pt-40 sm:pb-16 relative overflow-hidden">
      <div
        class="absolute -top-32 -right-24 w-[560px] h-[560px] rounded-full opacity-[0.14] blur-[130px] pointer-events-none"
        style="background: radial-gradient(circle, #E0A04D 0%, transparent 70%);"
        aria-hidden="true"
      >
      </div>

      <div class="max-w-content mx-auto px-5 sm:px-8 relative">
        <h1
          class="font-display font-medium text-tinta leading-[1.05] tracking-tight max-w-3xl"
          style="font-size: clamp(2rem, 5vw, 3.75rem);"
        >
          {quePreguntar.titulo}
        </h1>
        <p class="mt-7 max-w-2xl text-xl text-tinta/80 leading-relaxed">{quePreguntar.intro}</p>
      </div>
    </section>

    <section class="py-12 sm:py-16">
      <div class="max-w-content mx-auto px-5 sm:px-8">
        <ol class="grid gap-6 max-w-3xl">
          {quePreguntar.preguntas.map((p, i) => (
            <li class="reveal card-warm p-7 sm:p-8">
              <div class="flex gap-5">
                <span class="font-display text-3xl text-terracota leading-none shrink-0">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <div>
                  <h2 class="font-display text-xl sm:text-2xl text-tinta leading-snug">{p.q}</h2>
                  <p class="mt-3 text-lg text-tinta/75 leading-relaxed">{p.a}</p>
                </div>
              </div>
            </li>
          ))}
        </ol>

        <div class="reveal mt-10 max-w-3xl">
          <p class="text-lg text-tinta/80 leading-relaxed">{quePreguntar.cierre}</p>
          <a
            href={link('/como-trabajo')}
            class="inline-flex items-center gap-2 mt-5 text-base font-medium text-tinta underline underline-offset-4 hover:text-terracota transition"
          >
            Así las contesto yo
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </section>

    <Contacto
      titulo="Si quieres que te las conteste yo"
      texto="Me las haces por teléfono y te las contesto todas. Si de ahí sale trabajo, bien, y si no, también."
    />
  </main>
  <Footer />
  <WhatsappFab />
</BaseLayout>
