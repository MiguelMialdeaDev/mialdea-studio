---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { seo, gracias, site, link } from '../data/config';
---

<BaseLayout title={seo.gracias.title} description={seo.gracias.description} noindex={true}>
  <Nav />
  <main>
    <section class="pt-32 pb-24 sm:pt-48 sm:pb-36 relative overflow-hidden min-h-[70vh]">
      <div
        class="absolute -top-32 -right-24 w-[560px] h-[560px] rounded-full opacity-[0.16] blur-[130px] pointer-events-none"
        style="background: radial-gradient(circle, #C8553D 0%, transparent 70%);"
        aria-hidden="true"
      >
      </div>

      <div class="max-w-content mx-auto px-5 sm:px-8 relative max-w-2xl">
        <h1
          class="font-display font-medium text-tinta leading-[1.05] tracking-tight"
          style="font-size: clamp(2.5rem, 6vw, 4rem);"
        >
          {gracias.titulo}
        </h1>

        {gracias.parrafos.map((p) => (
          <p class="mt-6 text-xl text-tinta/80 leading-relaxed">{p}</p>
        ))}

        <a
          href={site.telefonoLink}
          class="inline-flex items-center gap-2 mt-8 text-lg font-medium text-tinta border border-linea bg-papel px-6 py-3.5 rounded-full hover:border-terracota transition"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.4.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1l-2.3 2.2z"></path>
          </svg>
          Llamar al {site.telefono}
        </a>

        <p class="mt-10 text-lg text-tinta/75 leading-relaxed border-t border-linea pt-8">
          {gracias.cierre}
        </p>
        <a
          href={link('/como-trabajo')}
          class="inline-flex items-center gap-2 mt-4 text-base font-medium text-tinta underline underline-offset-4 hover:text-terracota transition"
        >
          Cómo trabajo, paso a paso
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
