---
// PORTADA  ·  foco en captación (septiembre 2026)
//
// Orden pensado para el comprador que abre el enlace desde WhatsApp en la
// furgoneta: quién soy, qué hago, cuánto cuesta y cómo escribirme, todo en la
// primera pantalla. Después la prueba (dos webs reales), el precio, el
// proceso en cuatro pasos, para quién no es y la revisión gratis.
//
// Un solo botón de acción, siempre el mismo, y es verde: el comprador
// reconoce el icono de WhatsApp sin leer. El terracota queda para marca,
// reglas y el subrayador del titular.
//
// Presupuesto: 450 palabras visibles como máximo. Cero guiones.
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Portada from '../components/Portada.astro';
import Prueba from '../components/Prueba.astro';
import Precios from '../components/Precios.astro';
import Pasos from '../components/Pasos.astro';
import ParaQuienNo from '../components/ParaQuienNo.astro';
import Revision from '../components/Revision.astro';
import Footer from '../components/Footer.astro';
import WhatsappFab from '../components/WhatsappFab.astro';
import { seo } from '../data/config';
---

<BaseLayout title={seo.home.title} description={seo.home.description}>
  <Nav />
  <main id="inicio">
    <Portada />
    <Prueba />
    <Precios />
    <Pasos />
    <ParaQuienNo />
    <Revision />
  </main>
  <Footer />
  <WhatsappFab />
</BaseLayout>
