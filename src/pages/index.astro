---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import Valor from '../components/Valor.astro';
import Proyectos from '../components/Proyectos.astro';
import Servicios from '../components/Servicios.astro';
import Proceso from '../components/Proceso.astro';
import SobreMi from '../components/SobreMi.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
import WhatsappFab from '../components/WhatsappFab.astro';
---

<BaseLayout>
  <Nav />
  <main>
    <Hero />
    <Marquee />
    <Valor />
    <Proyectos />
    <Servicios />
    <Proceso />
    <SobreMi />
    <Contacto />
  </main>
  <Footer />
  <WhatsappFab />
</BaseLayout>
