---
// PORTADA
//
// Su unico trabajo: que alguien entienda que tiene un problema y que yo lo
// resuelvo. Nada mas. Lo que se lee DESPUES vive en su propia pagina.
//
// Se quitaron de aqui seis bloques que ya existian en otro sitio y que hacian
// que esta pagina tuviera 1.442 palabras, el triple que la landing de reformas
// (444 palabras), que es la que de verdad retiene gente:
//   Servicios y Proceso   -> /como-trabajo
//   SobreMi               -> /quien-soy
//   Faq                   -> /como-trabajo
//   Contacto (formulario) -> /contacto
//   Proximamente          -> /como-trabajo, en "si todavia no quieres una web"
//
// Y una sola accion de cierre: la revision de quince minutos, que es el
// escalon barato. Antes habia quince llamadas a la accion compitiendo.
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import Problema from '../components/Problema.astro';
import Villano from '../components/Villano.astro';
import Escaldado from '../components/Escaldado.astro';
import Historias from '../components/Historias.astro';
import Capacidad from '../components/Capacidad.astro';
import Revision from '../components/Revision.astro';
import Footer from '../components/Footer.astro';
import WhatsappFab from '../components/WhatsappFab.astro';
import { seo } from '../data/config';
---

<BaseLayout title={seo.home.title} description={seo.home.description}>
  <Nav />
  <main>
    <Hero />
    <Marquee />
    <Problema />
    <Villano />
    <Escaldado />
    <Historias limite={3} enlace={true} />
    <Capacidad />
    <Revision />
  </main>
  <Footer />
  <WhatsappFab />
</BaseLayout>
