---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Capacidad from '../components/Capacidad.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
import WhatsappFab from '../components/WhatsappFab.astro';
import { seo, quienSoy, site, comoTrabajo, link } from '../data/config';

import { existsSync } from 'node:fs';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const foto = `${base}${site.foto}`;
// Solo se pinta la etiqueta si el fichero existe: antes cada visita pedia un jpg que daba 404.
const hayFoto = existsSync('public' + site.foto);
---

<BaseLayout title={seo.quienSoy.title} description={seo.quienSoy.description}>
  <Nav />
  <main>
    <section class="pt-28 pb-16 sm:pt-40 sm:pb-24 relative overflow-hidden">

      <div class="max-w-content mx-auto px-[22px] sm:px-8 relative grid md:grid-cols-[320px_1fr] gap-10 md:gap-14 items-start">
        <div>
          <div class="rounded-lg overflow-hidden border border-linea bg-crema">
            {hayFoto ? (
              <img src={foto}
              alt="Miguel Mialdea, que es quien hace la web y quien te coge el teléfono"
              width="320"
              height="400"
              class="w-full h-[400px] object-cover" />
              ) : (
              null
              )}
          </div>
        </div>

        <div>
          <h1
            class="font-display font-bold text-tinta leading-[1.05] tracking-tight"
            style="font-size: clamp(2.25rem, 5.5vw, 3.75rem);"
          >
            {quienSoy.titulo}
          </h1>
          {quienSoy.parrafos.map((p) => (
            <p class="mt-6 text-xl text-tinta2 leading-relaxed">{p}</p>
          ))}

          <div class="mt-10 border-t border-linea pt-8">
            <p class="text-lg text-tinta2 leading-relaxed">{comoTrabajo.charla.texto}</p>
          </div>

          <div class="mt-8 flex flex-wrap gap-x-6 gap-y-3">
            <a
              href={link('/como-trabajo')}
              class="inline-flex items-center gap-2 text-base font-medium text-tinta underline underline-offset-4 hover:text-terracota transition"
            >
              Cómo trabajo, paso a paso
              <span aria-hidden="true">&rarr;</span>
            </a>
            <a
              href={link('/trabajos')}
              class="inline-flex items-center gap-2 text-base font-medium text-tinta underline underline-offset-4 hover:text-terracota transition"
            >
              Un trabajo contado por dentro
              <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <Capacidad />
    <Contacto
      titulo="Si quieres, hablamos"
      texto="Me cuentas qué negocio tienes y qué te está pasando, y te digo si esto te sirve o no."
    />
  </main>
  <Footer />
  <WhatsappFab />
</BaseLayout>

<style>
  .foto-ph {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 400px;
  }
  .foto-ph::after {
    content: 'Foto de Miguel pendiente';
    color: oklch(42% 0.012 45);
    font-size: 0.85rem;
  }
</style>
